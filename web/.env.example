# Copy to web/.env.local for local dev. On treehouse, the secrets
# below (AUTH_SECRET, GOOGLE_CLIENT_ID/SECRET, INTERNAL_API_SECRET,
# ADMIN_EMAIL) live in deploy/.env instead (see that file's own
# .env.example) — deploy/docker-compose.yml's web/admin services load it
# via env_file. The fixed, non-secret values (AUTH_DB_PATH, DB_PATH,
# API_INTERNAL_URL, APP_MODE) are set directly in docker-compose.yml's
# `environment:` block per service, not through deploy/.env.

# Auth.js's own signing secret (CSRF/state, independent of the database
# session rows themselves). Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Same Google OAuth client webapi.py already uses (deploy/.env's
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET) — reused here rather than under
# Auth.js's AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET convention, so there's one
# client, one pair of env vars, read by both languages.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL this app is reached at (through goosenest02's Ingress —
# never directly). Auth.js needs this to build correct OAuth callback URLs
# behind that reverse proxy; trustHost is set in src/auth.ts to trust it.
AUTH_URL=https://notes.example.com

# Auth.js's own tables (sessions/accounts/its own `users` record) —
# Node-only, on the `auth-db` compose volume. Never read by the Python side.
AUTH_DB_PATH=/data/auth-db/auth.db

# notes.db — shared with the Python api service. This app only ever
# touches the hand-written `users` table in it (§14.3); everything else
# (lectures/stage_cache/notes) is Python's.
DB_PATH=/data/notes-db/notes.db

# Base URL of the `api` service on the Docker-internal network (§14.2) —
# never the public internet.
API_INTERNAL_URL=http://api:8000

# Shared secret for signing internal_auth tokens when calling `api`'s
# /api/* routes. Must match deploy/.env's INTERNAL_API_SECRET exactly —
# same value, both processes.
INTERNAL_API_SECRET=

# The Google account allowed onto the `admin` service (M15). Matches
# deploy/.env's ADMIN_EMAIL.
ADMIN_EMAIL=

# "web" (default) or "admin" — selects which route surface this instance
# serves (src/proxy.ts, src/app/admin). Compose is expected to set
# this to "admin" for the `admin` service and leave it unset (or "web")
# for `web`.
APP_MODE=web
