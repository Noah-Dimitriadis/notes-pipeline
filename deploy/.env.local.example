# Copy to deploy/.env.local and fill in the two generated secrets below.
# Used only by deploy/docker-compose.local.yml — see that file's header
# comment for how to bring this stack up. Never used by the real
# treehouse deploy/.env; keep the two separate.

# Skips real Google OAuth entirely (both `web`'s Auth.js and `api`'s
# GoogleProvider/internal_auth checks) — every request runs as
# dev-local@notes-pipeline.local. Never set this anywhere but a local dev
# machine; nothing enforces that for you. See web_config.py/authz.ts.
AUTH_ENABLED=false

# Required even with AUTH_ENABLED=false — locally-stored Anthropic keys
# still get encrypted at rest via AES-256-GCM regardless of auth mode.
# Generate with:
#   python -c "from notes_pipeline.crypto import generate_master_key; print(generate_master_key())"
KEY_MASTER_KEY=

# Shared secret between `web` and `api` for internal_auth tokens. Unused
# when AUTH_ENABLED=false (require_internal_user short-circuits before
# checking it) but still required by WebConfig — any random string works
# locally, e.g.:
#   openssl rand -base64 32
INTERNAL_API_SECRET=local-dev-unused

# Required by WebConfig regardless of auth mode. Only matters if you flip
# AUTH_ENABLED back to true locally (real Google OAuth) — harmless
# placeholder otherwise.
ADMIN_EMAIL=dev-local@notes-pipeline.local

# Auth.js's own signing secret (CSRF/state) — `web` constructs its
# NextAuth() config unconditionally even with AUTH_ENABLED=false, so this
# still needs a value. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Unused in bypass mode (no real Google sign-in happens), but web/auth.ts
# references these at module load — harmless placeholders.
GOOGLE_CLIENT_ID=unused-local-dev
GOOGLE_CLIENT_SECRET=unused-local-dev
