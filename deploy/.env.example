# Copy to deploy/.env on the gaming box itself and fill in real values —
# these are all specific to that machine, none of them belong in git.

# `tailscale ip -4` on the box. web/api bind to this interface only.
TAILSCALE_IP=

# `getent group render` / `getent group video` on the box — the container's
# render/video group GIDs must match these numerically for /dev/dri
# passthrough to actually grant access. The Dockerfile defaults (104, 44)
# are common Debian/Ubuntu values but NOT guaranteed to match this box.
RENDER_GID=
VIDEO_GID=

# M13 — the hosted `api` service (notes_pipeline/webapi.py). All secrets;
# none of these belong in git either, same as everything else in this file.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). One client, shared by both consumers below — register
# BOTH redirect URIs on it: <MCP_BASE_URL>/auth/callback (FastMCP's
# GoogleProvider, api service) and <AUTH_URL>/api/auth/callback/google
# (Auth.js, web/admin service).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL friends' MCP clients see, e.g. https://notes.example.com/mcp.
# Also registered with Google as this OAuth client's redirect base.
MCP_BASE_URL=
# Same domain, no scheme/path — locks FastMCP's Host/Origin guard
# (allowed_hosts) so it isn't left at the "accept anything" default.
ALLOWED_HOST=

# M14 — the `web`/`admin` service (web/). Auth.js's own signing secret
# (CSRF/state — independent of the database session rows). Generate with
# `openssl rand -base64 32`.
AUTH_SECRET=
# Public URL this app is reached at, e.g. https://notes.example.com —
# through goosenest02's Ingress, never directly.
AUTH_URL=

# `python -c "from notes_pipeline.crypto import generate_master_key as g; print(g())"`
# AES-256-GCM key encrypting each user's stored Anthropic API key at rest.
# Losing this makes every stored key unrecoverable — back it up somewhere
# other than this file.
KEY_MASTER_KEY=

# Any long random string (e.g. `openssl rand -hex 32`) — shared secret the
# `web` app signs internal_auth tokens with when calling this service's
# /api/* routes. Must match whatever `web`'s own env sets for this.
INTERNAL_API_SECRET=

# The Google account allowed onto the `admin` service (M15).
ADMIN_EMAIL=
