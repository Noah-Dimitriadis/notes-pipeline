# Copy to deploy/.env on the gaming box itself and fill in real values —
# these are all specific to that machine, none of them belong in git.

# `tailscale ip -4` on the box. web/api bind to this interface only.
TAILSCALE_IP=

# `getent group render` / `getent group video` on the box — the container's
# render/video group GIDs must match these numerically for /dev/dri
# passthrough to actually grant access. The Dockerfile defaults (104, 44)
# are common Debian/Ubuntu values but NOT guaranteed to match this box.
RENDER_GID=
VIDEO_GID=
